# JanusGuard runtime output. Sample report files are not committed; the
# generated test fixtures (samples/*.apk) are also rebuildable on demand.
reports/*.md
reports/*.html
reports/*.json
!reports/.gitkeep

# Users may drop real APKs into the samples directory for ad-hoc testing.
# We only commit the synthetic generator and its README, not the .apk files.
samples/*.apk
